# Puerto — GoDaddy lo asigna automáticamente vía PORT
PORT=3001

# Conexión MySQL — GoDaddy inyecta DB_* automáticamente en producción
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_cpanel
DB_PASS=contraseña_cpanel
DB_NAME=nombre_base_datos

# Clave de sesión — cambiar por una cadena larga y aleatoria en producción
SESSION_SECRET=cambiar-por-valor-secreto-largo
